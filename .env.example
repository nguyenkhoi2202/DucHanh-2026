# Cổng chạy web
PORT=3000

# Tài khoản đầu tiên (Nha Khoa Bình Thuận), chỉ dùng khi DB chưa có tài khoản nào.
# Sau đó quản lý tài khoản bằng: npm run user -- ... (xem README)
APP_USERNAME=duchanh
APP_PASSWORD=

# Số giờ giữ đăng nhập
SESSION_HOURS=12

# File cơ sở dữ liệu SQLite (mặc định: data/duchanh.db)
# DB_PATH=/duong/dan/toi/duchanh.db

# Tài khoản nhận tiền hiển thị trên mã QR.
# BANK_CODE nhận mã BIN, mã viết tắt hoặc tên ngắn: xem https://qr.sepay.vn/banks.json
BANK_CODE=970441
BANK_NAME=VIB
BANK_ACCOUNT_NO=888974974
BANK_ACCOUNT_NAME=TRAN THI HA MY

# API key webhook SePay (để trống = chỉ hiện QR, không tự xác nhận đã nhận tiền).
# Đặt cùng giá trị trong SePay > Tích hợp Webhooks > Kiểu chứng thực: API Key (xem README),
# URL webhook: https://<ten-mien-cua-ban>/api/sepay/webhook
SEPAY_API_KEY=
