{
  "name": "nha-khoa-duc-hanh",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --ignore 'data/**' --ignore 'src/**' server/index.ts",
    "build": "vite build && esbuild server/index.ts server/user.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outdir=dist-server",
    "clean": "rm -rf dist dist-server",
    "lint": "tsc --noEmit",
    "start": "NODE_ENV=production node dist-server/index.js",
    "sepay:simulate": "tsx scripts/sepay-simulate.ts",
    "user": "tsx server/user.ts",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "overrides": {
    "qs": "^6.16.2"
  }
}
